# Шаблон окружения для docker compose. Скопируйте в .env и заполните.
#   cp .env.example .env
#
# .env в git НЕ попадает (.gitignore) и в образ НЕ попадает (.dockerignore) —
# переменные передаются рантаймом. Не коммитьте заполненный файл.

# ─── Обязательное ────────────────────────────────────────────────────────────
# Токен бота от @BotFather.
TELEGRAM_TOKEN=123456:AA...
# Токен МойСклад. Нужен до шага 4 плана отключения: config.py падает без него.
# После удаления МС-кода переменная уходит вместе с ним.
MS_TOKEN=
# Пароль Postgres. Без него compose откажется стартовать (осознанный гард).
POSTGRES_PASSWORD=

# ─── Роли (Telegram user id через запятую) ───────────────────────────────────
# Без ADMIN_IDS и BOSS_IDS соответствующие роли просто не настроены —
# config.py предупредит в логе. Новый пользователь по умолчанию guest.
ADMIN_IDS=
BOSS_IDS=
MANAGER_IDS=
ALLOWED_USERS=

# ─── Часовой пояс ────────────────────────────────────────────────────────────
# КРИТИЧНО. created_at пишется в кадре контейнера (utils.helpers.local_now),
# и «сегодня» в аналитике считается в нём же. Ставьте бизнес-зону, иначе
# вечерние записи выпадают из «сегодня» и бот расходится с WebApp.
TZ=Asia/Tashkent

# ─── WebApp ──────────────────────────────────────────────────────────────────
# Публичный HTTPS-адрес WebApp. Telegram молча игнорирует кнопку без HTTPS —
# нужен reverse-proxy с сертификатом перед сервисом webapp.
WEBAPP_URL=https://example.com
# Порт, который compose публикует на 127.0.0.1 для вашего reverse-proxy.
WEBAPP_PORT=8080
# Telegram-webhook вместо long-polling (опционально). При 1 задайте секрет.
TG_USE_WEBHOOK=0
TG_WEBHOOK_SECRET=

# ─── МойСклад (до шага 4) ────────────────────────────────────────────────────
# UUID организации и склада. Пусто — берётся первый из API.
MS_ORG_ID=
MS_STORE_ID=
# Секрет в пути вебхука МС. Пусто — сгенерируется, но тогда он меняется при
# каждом рестарте и подписки придётся перерегистрировать.
MS_WEBHOOK_SECRET=
# Окно и лимит cron-реконсиляции (tasks/run_ms_reconcile).
MS_RECONCILE_WINDOW_DAYS=30
MS_RECONCILE_LIMIT=500

# ─── Накладные и документы ───────────────────────────────────────────────────
# Название фирмы в шапке печатной формы.
COMPANY_NAME=FARID IMPEKS LLC
# Логотип накладной. Положите файл в том appdata:
#   docker compose cp logo.png bot:/app/data/logo.png
# Файла нет — накладная печатается без картинки, это не ошибка.
INVOICE_LOGO_PATH=/app/data/logo.png

# ─── Прочее ──────────────────────────────────────────────────────────────────
# Валюта отображения.
BASE_CURRENCY=USD
# Интервал резервного поллера отгрузок, сек. Основной канал — вебхук МС.
CHECK_INTERVAL_SEC=900
# Куда tasks/run_backup шлёт дамп БД (приватный канал; бот должен быть в нём).
BACKUP_TG_CHAT_ID=

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=bot
POSTGRES_DB=moysklad_bot

# ─── Сборка образа ───────────────────────────────────────────────────────────
# 0 убирает LibreOffice (~400 МБ). Нужен только генерации юр. документов,
# которая ещё не написана.
WITH_LIBREOFFICE=1
# SHA для cache-busting статики: docker compose build проставит его сам, если
# экспортировать переменную — export GIT_COMMIT_SHA=$(git rev-parse HEAD)
GIT_COMMIT_SHA=

# ─── НЕ включать на проде ────────────────────────────────────────────────────
# DEV_AUTH_BYPASS обходит проверку подписи Telegram initData. В config есть
# жёсткий предохранитель (при заданном DATABASE_URL обход отключается), но
# переменной здесь быть не должно вовсе.
# DEV_AUTH_BYPASS=
# DEV_USER_ID=
